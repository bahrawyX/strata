# Strata's own meta database — used to store users, sessions, and encrypted connections.
# Get a free Postgres database from https://neon.tech and paste the connection string here.
DATABASE_URL=

# BetterAuth secret — used to sign session tokens. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL of your deployment (no trailing slash). Used by BetterAuth for cookies and callbacks.
BETTER_AUTH_URL=http://localhost:3000

# AES-256-GCM key used to encrypt user connection strings at rest.
# MUST be a 32-byte hex string (64 hex characters). Generate with: openssl rand -hex 32
# Treat this like a database password — rotating it will invalidate all stored connections.
ENCRYPTION_KEY=

# Public URL used by the BetterAuth client in the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic API key — powers the SQL co-pilot (⌘K in the editor).
# Get one at https://console.anthropic.com/. Without it, the co-pilot UI
# still renders but returns a "set ANTHROPIC_API_KEY" notice instead of SQL.
ANTHROPIC_API_KEY=

# Stripe — payments + subscription gate. The settings/billing page shows a
# config notice until all three are set on the server.
#   STRIPE_SECRET_KEY:        sk_test_... or sk_live_... from https://dashboard.stripe.com/apikeys
#   STRIPE_WEBHOOK_SECRET:    whsec_... from a webhook endpoint pointed at
#                             https://<your-domain>/api/stripe/webhook
#   STRIPE_PRICE_ID_PRO:      price_... the recurring price ID for the Pro plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
